# ==============================================================================
# AgriConnect - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT commit your actual .env file or real secrets to GitHub.
# ==============================================================================

# --- Django Core Settings ---
# In development, set DEBUG=True. In production (Render), set DEBUG=False.
DEBUG=True

# Provide a secure, random 50+ character string in production.
# On Render, this can be automatically generated by the service blueprint.
SECRET_KEY=your-secure-random-secret-key-here

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Comma-separated list of trusted origins for CSRF protection (Django 4.0+)
CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# --- Database Settings (PostgreSQL / Neon) ---
# Leave blank to use local SQLite (db.sqlite3) during development.
# For production on Neon, paste your connection string (direct or pooled):
# Example: postgresql://<username>:<password>@<ep-hostname>.neon.tech/<dbname>?sslmode=require
DATABASE_URL=

# --- Open Government Data (data.gov.in) Mandi API Configuration ---
# Register and get your free personal API key at: https://data.gov.in
DATA_GOV_IN_API_KEY=your-data-gov-in-api-key-here
DATA_GOV_IN_MANDI_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# --- Deployment Build Options ---
# Set to 'true' to run seed commands during the Render build phase.
# Set to 'false' if you prefer to seed manually or have persistent data.
RUN_SEEDS_ON_BUILD=true